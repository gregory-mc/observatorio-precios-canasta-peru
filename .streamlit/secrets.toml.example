# Plantilla de secretos del dashboard.
#
# LOCAL: no hace falta este archivo — la app lee `SUPABASE_DB_URL` de `.env`,
# el mismo secret que usa la carga.
#
# STREAMLIT COMMUNITY CLOUD: copiá este contenido en Settings → Secrets de la
# app, con la URL real. NO commitees el secrets.toml con la credencial: está en
# .gitignore por algo.

SUPABASE_DB_URL = "postgresql://usuario:password@host:6543/postgres"
